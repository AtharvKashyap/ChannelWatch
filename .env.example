# Local development environment variables.
# Copy this file to .env and adjust as needed. Never commit .env — no secrets
# are committed to this repository; .env is git-ignored.

DATABASE_URL=postgres://channelwatch:channelwatch@localhost:5432/channelwatch
API_PORT=8787
WEB_PORT=3000

# Base URL of the public API that apps/web calls (services/api, /api/v1).
# Exposed to the browser bundle by Next.js because of the NEXT_PUBLIC_ prefix,
# so it must contain no secrets — it is a public origin only.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
