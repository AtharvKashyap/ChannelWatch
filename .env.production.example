# Production environment template (M3 Track F). Copy per-environment and fill
# in real values; never commit a filled file. Every variable the production
# deployment reads is documented here.

# ---- services/api -----------------------------------------------------------

# Postgres connection string (managed instance; require TLS where supported).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/channelwatch

# Port the API listens on (platform-injected on most hosts).
API_PORT=8787

# Exact public origin of apps/web, reflected in CORS with credentials for the
# /review console. MUST be a single specific origin, never "*".
WEB_ORIGIN=https://www.example.org

# Rate-limit counter store: "memory" (single instance only) or "postgres"
# (durable, survives restarts and horizontal scale — REQUIRED for multi-instance
# production; uses the rate_limit_counters table from migration 0002).
RATE_LIMIT_STORE=postgres

# Structured request logging (JSON lines; no IPs or user identifiers — see
# PRIVACY.md): "on" in production, "off" to silence.
REQUEST_LOG=on

# Coarse abuse-monitoring counters served at the reviewer-guarded
# GET /api/v1/reviewer/metrics: "on" in production.
ABUSE_METRICS=on

# ---- apps/web ---------------------------------------------------------------

# Public origin of the API, baked into the browser bundle (no secrets).
NEXT_PUBLIC_API_BASE_URL=https://api.example.org

# ---- apps/extension (BUILD-time, not runtime) -------------------------------

# Public API origin baked into the MV3 bundle: manifest host_permissions AND
# the settings default both read this at build time. If unset, the build bakes
# http://localhost:8787 and the store package is BROKEN — always set it for a
# release build (see docs/reproducible-build.md).
VITE_API_BASE_URL=https://api.example.org
