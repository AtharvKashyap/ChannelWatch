{
  "name": "@channelwatch/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed-reviewer": "tsx scripts/seed-reviewer.ts",
    "import:research": "tsx scripts/import-research.ts"
  },
  "dependencies": {
    "@channelwatch/graph": "workspace:*",
    "@channelwatch/schemas": "workspace:*",
    "@channelwatch/scoring": "workspace:*",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.1",
    "postgres": "3.4.9",
    "yaml": "^2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hono/node-server": "1.14.4",
    "@types/node": "^20.17.9",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.12",
    "vitest": "2.1.9"
  }
}
